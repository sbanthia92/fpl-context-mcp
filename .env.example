# Copy to .env if you want to set any of these. The server needs no configuration to run
# over stdio; everything below applies to the HTTP transport (fpl-context-mcp --transport http).

# Require "Authorization: Bearer <token>" on /mcp. Comma-separate several keys, e.g.
# MCP_AUTH_TOKEN=key-alice,key-bob. Leave empty only when bound to localhost.
# MCP_AUTH_TOKEN=

# Per-caller requests/min on /mcp (0 = off). Set before exposing publicly, e.g. 120.
# MCP_RATE_LIMIT_PER_MIN=120

# Header with the real client IP behind a trusted proxy (e.g. Fly-Client-IP).
# MCP_CLIENT_IP_HEADER=
